<section class="section wrap"><h1>{{ 'cart.title' | t }}</h1>{% if cart.item_count == 0 %}<p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.root_url }}">{{ 'cart.continue' | t }}</a>{% else %}<form action="{{ routes.cart_url }}" method="post" class="cart-form">{% for item in cart.items %}<div class="cart-item">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '120px' }}{% endif %}<div><a href="{{ item.url }}"><h2>{{ item.product.title | escape }}</h2></a>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}<p>{{ item.final_line_price | money }}</p>{% for allocation in item.line_level_discount_allocations %}<p>{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})</p>{% endfor %}<a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div><div><label for="CartQuantity-{{ forloop.index }}">{{ 'product.quantity' | t }}</label><input id="CartQuantity-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}" {% if item.variant.quantity_rule.max != blank %}max="{{ item.variant.quantity_rule.max }}"{% endif %}></div></div>{% endfor %}<div class="cart-summary"><label for="CartNote">{{ 'cart.note' | t }}</label><textarea id="CartNote" name="note">{{ cart.note | escape }}</textarea>{% for application in cart.cart_level_discount_applications %}<p>{{ application.title | escape }} (−{{ application.total_allocated_amount | money }})</p>{% endfor %}<h2>{{ 'cart.subtotal' | t }}: {{ cart.total_price | money }}</h2><p>{{ 'cart.taxes' | t }}</p><button type="submit" name="update" class="button secondary">{{ 'cart.update' | t }}</button><button type="submit" name="checkout" class="button">{{ 'cart.checkout' | t }}</button></div></form>{% endif %}</section>
{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
