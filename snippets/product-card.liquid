<article class="product-card"><a href="{{ card_product.url }}">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 600, 800', sizes: '(min-width: 750px) 33vw, 50vw' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}<h2>{{ card_product.title | escape }}</h2><p>{{ card_product.price | money }}{% if card_product.compare_at_price > card_product.price %} <s>{{ card_product.compare_at_price | money }}</s>{% endif %}</p></a></article>
